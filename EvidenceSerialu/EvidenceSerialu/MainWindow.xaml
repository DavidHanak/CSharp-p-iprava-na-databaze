<Window x:Class="EvidenceSerialu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidence Seriálů" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Nový záznam" Grid.Row="0" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="5,0">
                    <TextBlock Text="Název:"/>
                    <TextBox x:Name="txtNazev" Width="150"/>
                </StackPanel>
                <StackPanel Margin="5,0">
                    <TextBlock Text="Tvůrce:"/>
                    <TextBox x:Name="txtAutor" Width="120"/>
                </StackPanel>
                <StackPanel Margin="5,0">
                    <TextBlock Text="Rok:"/>
                    <TextBox x:Name="txtRok" Width="50"/>
                </StackPanel>
                <StackPanel Margin="5,0">
                    <TextBlock Text="Žánr:"/>
                    <TextBox x:Name="txtZanr" Width="100"/>
                </StackPanel>
                <StackPanel Margin="5,0">
                    <TextBlock Text="Série:"/>
                    <TextBox x:Name="txtKusy" Width="40"/>
                </StackPanel>
                <Button Content="Přidat" Click="BtnPridat_Click" Width="80" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="dgShow" Grid.Row="1" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Název" Binding="{Binding Nazev}" Width="*"/>
                <DataGridTextColumn Header="Tvůrce" Binding="{Binding Autor}" Width="*"/>
                <DataGridTextColumn Header="Rok" Binding="{Binding RokVydani}" Width="60"/>
                <DataGridTextColumn Header="Žánr" Binding="{Binding Zanr}" Width="100"/>
                <DataGridTextColumn Header="Série" Binding="{Binding PocetKusu}" Width="50"/>
                <DataGridCheckBoxColumn Header="Dostupná" Binding="{Binding JeDostupna}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Smazat vybraný seriál" Grid.Row="2" Click="BtnSmazat_Click" 
                HorizontalAlignment="Right" Margin="0,10,0,0" Padding="10,5" Background="#FFFFEBEB"/>
    </Grid>
</Window>